Text","underlined":false,"variables":[],"effects":[],"behaviors":[],"string":"","font":"","characterSize":14,"color":{"r":210,"g":215,"b":215}}],"events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":"\nconst player = runtimeScene.getObjects(\"Player\")[0];\nif (!player) return;\nconst dt = runtimeScene.getElapsedTime() / 1000;\nconst input = gdjs.evtTools.input;\nconst solids = runtimeScene.getObjects(\"Solid\");\nconst promptObj = runtimeScene.getObjects(\"Prompt\")[0];\nconst statusObj = runtimeScene.getObjects(\"Status\")[0];\nconst gv = runtimeScene.getGame().getVariables();\nconst px = () => player.getX();\nconst py = () => player.getY();\nconst radius = 11;\nfunction circleRect(cx,cy,r,o){\n  const x=o.getX(), y=o.getY(), w=o.getWidth(), h=o.getHeight();\n  const qx=Math.max(x,Math.min(cx,x+w)), qy=Math.max(y,Math.min(cy,y+h));\n  const dx=cx-qx,dy=cy-qy; return dx*dx+dy*dy<r*r;\n}\nfunction blocked(x,y){\n  for(const s of solids) if(circleRect(x,y,radius,s)) return true;\n  return false;\n}\nlet dx=0,dy=0;\nif(input.isKeyPressed(runtimeScene,\"a\")||input.isKeyPressed(runtimeScene,\"Left\")) dx--;\nif(input.isKeyPressed(runtimeScene,\"d\")||input.isKeyPressed(runtimeScene,\"Right\")) dx++;\nif(input.isKeyPressed(runtimeScene,\"w\")||input.isKeyPressed(runtimeScene,\"Up\")) dy--;\nif(input.isKeyPressed(runtimeScene,\"s\")||input.isKeyPressed(runtimeScene,\"Down\")) dy++;\nif(dx||dy){\n  const m=Math.hypot(dx,dy);dx/=m;dy/=m;\n  const sprint=input.isKeyPressed(runtimeScene,\"LShift\")||input.isKeyPressed(runtimeScene,\"RShift\");\n  const speed=sprint?210:135;\n  const nx=px()+dx*speed*dt, ny=py()+dy*speed*dt;\n  if(!blocked(nx,py())) player.setX(nx);\n  if(!blocked(px(),ny)) player.setY(ny);\n}\nplayer.setZOrder(Math.floor(player.getY()));\nconst door=runtimeScene.getObjects(\"DoorZone\")[0];\nconst wz=runtimeScene.getObjects(\"WardrobeZone\")[0];\nconst wc=runtimeScene.getObjects(\"WardrobeClosed\")[0];\nconst bp=runtimeScene.getObjects(\"Backpack\")[0];\nconst key=runtimeScene.getObjects(\"KeyItem\")[0];\nconst near=(o,d=42)=>o&&Math.hypot(px()-(o.getX()+o.getWidth()/2),py()-(o.getY()+o.getHeight()/2))<d;\nlet message=\"\";\nconst wardrobeOpen=gv.get(\"WardrobeOpen\").getAsBoolean();\nconst bpTaken=gv.get(\"BackpackTaken\").getAsBoolean();\nconst keyTaken=gv.get(\"KeyTaken\").getAsBoolean();\nif(wc) wc.setOpacity(wardrobeOpen?0:255);\nif(bp) bp.setOpacity(wardrobeOpen&&!bpTaken?255:0);\nif(key) key.setOpacity(wardrobeOpen&&!keyTaken?255:0);\nif(!wardrobeOpen && near(wz,60)) message=\"E  OTWÓRZ SZAFĘ\";\nelse if(wardrobeOpen && !bpTaken && near(bp,40)) message=\"E  PODNIEŚ PLECAK\";\nelse if(wardrobeOpen && !keyTaken && near(key,40)) message=\"E  PODNIEŚ KLUCZ\";\nelse if(near(door,55)) message=\"E  WEJDŹ DO ŁAZIENKI\";\nif(input.wasKeyJustPressed(runtimeScene,\"e\")){\n  if(!wardrobeOpen && near(wz,60)) gv.get(\"WardrobeOpen\").setBoolean(true);\n  else if(wardrobeOpen && !bpTaken && near(bp,40)) gv.get(\"BackpackTaken\").setBoolean(true);\n  else if(wardrobeOpen && !keyTaken && near(key,40)) gv.get(\"KeyTaken\").setBoolean(true);\n  else if(near(door,55)) gdjs.evtTools.runtimeScene.replaceScene(runtimeScene,\"Bathroom\",false);\n}\nif(promptObj) promptObj.setString(message);\nif(statusObj) statusObj.setString(\"GDevelop migration v0.1   Plecak: \"+(gv.get(\"BackpackTaken\").getAsBoolean()?\"TAK\":\"NIE\")+\"   Klucz: \"+(gv.get(\"KeyTaken\").getAsBoolean()?\"TAK\":\"NIE\"));\n","parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"layers":[{"name":"","visibility":true,"cameras":[{"defaultSize":true,"defaultViewport":true,"height":0,"viewportBottom":1,"viewportLeft":0,"viewportRight":1,"viewportTop":0,"width":0}],"effects":[]}],"behaviorsSharedData":[]},{"b":9,"disableInputWhenNotFocused":true,"mangledName":"Bathroom","name":"Bathroom","r":9,"standardSortMethod":true,"stopSoundsOnStartup":true,"title":"Bathroom","v":9,"uiSettings":{"grid":false,"gridType":"rectangular","gridWidth":32,"gridHe