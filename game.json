eScene.getObjects(\"Player\")[0];\nif (!player) return;\nconst dt = runtimeScene.getElapsedTime() / 1000;\nconst input = gdjs.evtTools.input;\nconst solids = runtimeScene.getObjects(\"Solid\");\nconst promptObj = runtimeScene.getObjects(\"Prompt\")[0];\nconst statusObj = runtimeScene.getObjects(\"Status\")[0];\nconst radius=11;\nfunction circleRect(cx,cy,r,o){\n  const x=o.getX(), y=o.getY(), w=o.getWidth(), h=o.getHeight();\n  const qx=Math.max(x,Math.min(cx,x+w)), qy=Math.max(y,Math.min(cy,y+h));\n  const dx=cx-qx,dy=cy-qy; return dx*dx+dy*dy<r*r;\n}\nfunction blocked(x,y){for(const s of solids) if(circleRect(x,y,radius,s)) return true; return false;}\nlet dx=0,dy=0;\nif(input.isKeyPressed(runtimeScene,\"a\")||input.isKeyPressed(runtimeScene,\"Left\")) dx--;\nif(input.isKeyPressed(runtimeScene,\"d\")||input.isKeyPressed(runtimeScene,\"Right\")) dx++;\nif(input.isKeyPressed(runtimeScene,\"w\")||input.isKeyPressed(runtimeScene,\"Up\")) dy--;\nif(input.isKeyPressed(runtimeScene,\"s\")||input.isKeyPressed(runtimeScene,\"Down\")) dy++;\nif(dx||dy){const m=Math.hypot(dx,dy);dx/=m;dy/=m;const speed=135;const nx=player.getX()+dx*speed*dt,ny=player.getY()+dy*speed*dt;if(!blocked(nx,player.getY()))player.setX(nx);if(!blocked(player.getX(),ny))player.setY(ny);}\nplayer.setZOrder(Math.floor(player.getY()));\nconst door=runtimeScene.getObjects(\"DoorZone\")[0];\nconst near=door&&Math.hypot(player.getX()-(door.getX()+door.getWidth()/2),player.getY()-(door.getY()+door.getHeight()/2))<58;\nif(promptObj) promptObj.setString(near?\"E  WRÓĆ DO POKOJU 404\":\"\");\nif(statusObj) statusObj.setString(\"Łazienka — scena GDevelop\");\nif(near && input.wasKeyJustPressed(runtimeScene,\"e\")) gdjs.evtTools.runtimeScene.replaceScene(runtimeScene,\"Room404\",false);\n","parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"layers":[{"name":"","visibility":true,"cameras":[{"defaultSize":true,"defaultViewport":true,"height":0,"viewportBottom":1,"viewportLeft":0,"viewportRight":1,"